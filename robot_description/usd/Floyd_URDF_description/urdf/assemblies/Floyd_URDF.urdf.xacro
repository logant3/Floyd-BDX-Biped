    <!-- ROS 2 control: generated generic system -->
    <ros2_control name="${prefix}Floyd_URDF_system" type="system">
      <hardware>
        <plugin>mock_components/GenericSystem</plugin>
        <param name="cmd_topic">sim/Floyd_URDF_system/cmd</param>
        <param name="state_topic">sim/Floyd_URDF_system/state</param>
      </hardware>

      <joint name="${prefix}LeftAnklePitch">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
      <joint name="${prefix}LeftHipPitch">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
