        <origin xyz="0.029877 -0.000000 -0.002039" rpy="0 0 0"/>
        <mass value="0.099119"/>
        <inertia ixx="2.527369e-05" ixy="1.591640e-17" ixz="-1.343212e-05"
                 iyy="1.022096e-04" iyz="6.665319e-18" izz="1.100274e-04"/>
      </inertial>
      <visual>
        <origin xyz="-0.000000 0.000000 -0.047500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/HipRollMountLeft.dae" scale="1 1 1"/>
        </geometry>
        <material name="Aluminum"/>
