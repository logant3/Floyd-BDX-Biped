    <link name="${prefix}RS02_LeftAnklePitch">
      <inertial>
        <origin xyz="0.123268 0.034558 -0.019822" rpy="0 0 0"/>
        <mass value="1.636213"/>
        <inertia ixx="8.807747e-04" ixy="-3.455211e-04" ixz="4.537411e-05"
                 iyy="2.698350e-03" iyz="8.623581e-06" izz="3.145175e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.135254 0.036254 -0.001500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/RS02_LeftAnklePitch.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.135254 0.036254 -0.001500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/RS02_LeftAnklePitch_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}RS02_RightAnklePitch">
      <inertial>
        <origin xyz="0.123268 0.034558 0.019822" rpy="0 0 0"/>
        <mass value="1.636213"/>
        <inertia ixx="8.807746e-04" ixy="-3.455211e-04" ixz="-4.537409e-05"
                 iyy="2.698350e-03" iyz="-8.623566e-06" izz="3.145175e-03"/>
      </inertial>
      <visual>
        <origin xyz="0.135254 0.036254 0.001500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/RS02_RightAnklePitch.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="0.135254 0.036254 0.001500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/RS02_RightAnklePitch_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}FootPadLeft">
      <inertial>
        <origin xyz="-0.017141 -0.026650 -0.066391" rpy="0 0 0"/>
        <mass value="0.952416"/>
        <inertia ixx="2.401400e-03" ixy="-1.567175e-05" ixz="-7.502641e-05"
                 iyy="3.769323e-04" iyz="-1.510958e-05" izz="2.338204e-03"/>
      </inertial>
      <visual>
        <origin xyz="-0.118071 -0.138154 0.226886" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/FootPadLeft.dae" scale="1 1 1"/>
        </geometry>
        <material name="Steel"/>
      </visual>
      <collision>
        <origin xyz="-0.118071 -0.138154 0.226886" rpy="0 0 0"/>
        <geometry>
