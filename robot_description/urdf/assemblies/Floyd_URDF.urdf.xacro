        <mass value="0.099119"/>
        <inertia ixx="2.527369e-05" ixy="1.623018e-17" ixz="1.343212e-05"
                 iyy="1.022096e-04" iyz="-6.557230e-18" izz="1.100274e-04"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 -0.000000 0.047500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/HipRollMountRight.dae" scale="1 1 1"/>
        </geometry>
        <material name="Aluminum"/>
      </visual>
      <collision>
        <origin xyz="0.000000 -0.000000 0.047500" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/HipRollMountRight_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}RS03_LeftHipPitch">
      <inertial>
        <origin xyz="-0.001013 -0.055597 -0.026110" rpy="0 0 0"/>
        <mass value="2.310484"/>
        <inertia ixx="9.421651e-03" ixy="2.563820e-06" ixz="-8.561347e-06"
                 iyy="2.539521e-03" iyz="-1.257142e-05" izz="1.029192e-02"/>
      </inertial>
      <visual>
        <origin xyz="-0.000000 0.000000 -0.056600" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/RS03_LeftHipPitch.dae" scale="1 1 1"/>
