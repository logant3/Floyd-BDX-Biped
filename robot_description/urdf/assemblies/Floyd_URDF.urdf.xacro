      <collision>
        <origin xyz="-0.000000 0.000000 -0.056600" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/RS03_LeftHipPitch_collision.stl" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>
    </link>

    <link name="${prefix}RS03_RightKneePitch">
      <inertial>
        <origin xyz="-0.001058 -0.055597 0.026110" rpy="0 0 0"/>
        <mass value="2.310491"/>
        <inertia ixx="9.421679e-03" ixy="7.042172e-06" ixz="1.046711e-05"
                 iyy="2.539315e-03" iyz="1.257940e-05" izz="1.029174e-02"/>
      </inertial>
      <visual>
        <origin xyz="0.000000 -0.111000 0.056600" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://Floyd_URDF_description/meshes/Floyd_URDF/RS03_RightKneePitch.dae" scale="1 1 1"/>
